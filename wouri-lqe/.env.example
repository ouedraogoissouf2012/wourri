# Environnement : dev | prod. En prod, un LQE_SECRET faible/par defaut => refus de demarrage.
LQE_ENV=dev
LQE_DATA_DIR=./data
LQE_SECRET=change-me-min-16-chars
# Comptes : JSON liste {user, password, language}
LQE_ACCOUNTS=[{"user":"provider_bci","password":"change-me-8chars","language":"bci"},{"user":"locuteur_dyu","password":"change-me-8chars","language":"dyu"}]
# Langues : activees EN BASE (table `languages`), jamais via env.
#   - seed initial dyu/bci = migration 003 (appliquee au demarrage)
#   - ajouter une langue = un upsert (INSERT), zero changement de code
LQE_CORS_ORIGINS=http://localhost:5173

LQE_ADMIN_USER=
LQE_ADMIN_PASSWORD=

# ===== PostgreSQL + pgvector (ADR-0034) =====
LQE_DB_SCHEMA=lqe
# Option 1 : URL complete (prioritaire)
LQE_DATABASE_URL=
# Option 2 : composants (host = nom du service Docker 'postgres' en prod)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=wourri
POSTGRES_DB=wourri_prod
POSTGRES_PASSWORD=
POSTGRES_PASSWORD_FILE=
