# WOURI - Configuration
# Copier ce fichier vers .env et remplir les valeurs

# ──────────────────────────────────────────────────
# ENVIRONNEMENT
# ──────────────────────────────────────────────────
# "development" (défaut) ou "production"
# En production : API_SECRET_KEY obligatoire, debug forcé à False
ENV=development

# ──────────────────────────────────────────────────
# SÉCURITÉ — OBLIGATOIRE EN PRODUCTION
# ──────────────────────────────────────────────────
# Clé secrète pour authentifier les appels API (header X-API-Key)
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
# OBLIGATOIRE si ENV=production (le serveur refuse de démarrer sans elle)
API_SECRET_KEY=

# CORS démo publique (ADR-0032) — CSV d'origines Console Vercel.
# Vide = aucun CORS en prod (sûr). Exemple :
# ALLOWED_ORIGINS=https://wouri-console.vercel.app
# Pose aussi ENV=production pour couper /docs et /openapi.
ALLOWED_ORIGINS=

# Locuteur LQE (#433) — Better Auth sur Convex
# CONVEX_SITE_URL ou CONVEX_BASE_URL = URL *.convex.site (sign-in + /lqe/bronze-task)
# CONVEX_CALLBACK_KEY / X_CALLBACK_KEY = même clé que WhatsApp
# WOURI_ORGANIZATION_ID = org du locuteur (ex. demo-coop-a)
# Côté Convex dashboard : AUTH_EMAIL_PASSWORD_ENABLED=true et SITE_URL
CONVEX_SITE_URL=
CONVEX_BASE_URL=
CONVEX_CALLBACK_KEY=
WOURI_ORGANIZATION_ID=

# Provider Baoulé — login /admin/baoule/ (user + mdp, min 8 car.)
BAOULE_PROVIDER_USER=
BAOULE_PROVIDER_PASSWORD=

# ──────────────────────────────────────────────────
# RATE LIMITING (issue #307, ADR-0018)
# ──────────────────────────────────────────────────
# Limite GLOBALE unique appliquée à toutes les routes (format lib `limits` :
# "120/minute", "10/second", "1000/hour"). Validée au démarrage (format
# invalide = refus de démarrer). Le trafic authentifié par X-API-Key valide
# (whatsapp-server) est EXEMPTÉ. Compteurs en mémoire PAR worker uvicorn.
RATE_LIMIT=120/minute

# ──────────────────────────────────────────────────
# APIs EXTERNES
# ──────────────────────────────────────────────────
# DeepSeek API (obligatoire pour le chat et les fallbacks)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ──────────────────────────────────────────────────
# OPTIONS
# ──────────────────────────────────────────────────
DEBUG=true
TTS_FRENCH_VOICE=fr-FR-VivienneMultilingualNeural
AUDIO_OUTPUT_DIR=static/audio

# ──────────────────────────────────────────────────
# CHEMINS OPTIONNELS (si outils non dans le PATH)
# ──────────────────────────────────────────────────
# FFmpeg — laisser vide si ffmpeg est dans le PATH système
# Windows : C:/ffmpeg/bin/ffmpeg.exe
# Linux   : /usr/bin/ffmpeg
FFMPEG_PATH=

# Modèle NeMo ASR (Soloni bambara)
# Par défaut : ~/.cache/huggingface/hub/models--RobotsMali--soloni-114m-tdt-ctc-v0/...
NEMO_MODEL_PATH=

# ──────────────────────────────────────────────────
# DEBUG — dump audio STT (⚠ PII)
# ──────────────────────────────────────────────────
# Si défini, CHAQUE vocal utilisateur reçu par /api/stt/transcribe est copié
# dans ce dossier pour diagnostic. ⚠ Les vocaux sont des données personnelles
# (conformité ARTCI) : activer UNIQUEMENT pour un debug ponctuel, purger le
# dossier après, et ne JAMAIS laisser actif en production.
# Défaut (vide) : aucun dump.
WOURRI_DEBUG_AUDIO_DIR=

# ──────────────────────────────────────────────────
# RÉTENTION LOGS PII (issue #215, ADR-0025)
# ──────────────────────────────────────────────────
# Durées de conservation appliquées par la purge quotidienne in-app
# (et par scripts/purge_logs.py). Justifications par finalité :
# docs/compliance/artci-logs.md (conformité ARTCI).
# - LOG_RETENTION_DAYS : logs applicatifs wourri-YYYY-MM-DD.log
#   (transcriptions en clair → 30 j max justifiés)
# - FEEDBACK_RETENTION_DAYS : feedback-YYYY-MM.jsonl (pseudonymisés,
#   reporting C5 sur un cycle agricole → 365 j)
LOG_RETENTION_DAYS=30
FEEDBACK_RETENTION_DAYS=365
# Interrupteur de la purge (gel ops ponctuel ; la suite de tests le met à
# false). La conformité ARTCI exige true en production.
LOG_RETENTION_ENABLED=true

# ──────────────────────────────────────────────────
# PERFORMANCE — feature flags ML (issue #42)
# ──────────────────────────────────────────────────
# Profils typiques (mesures T1 + ADR-0011, pour 1 worker API) :
#   Minimal Dioula (machine 4 GB) :
#     ENABLE_WHISPER=false
#     ENABLE_MMS_DYU=true
#     ENABLE_MMS_BAM=false
#     PRELOAD_TTS_DIOULA=true
#     PRELOAD_TTS_BAMBARA=false
#   Standard multilingue (machine 8 GB, defaut) :
#     tous les flags ci-dessous a true
#   Full / benchmark (machine 16 GB) :
#     profil standard + premier appel explicite a Whisper et NLLB pour
#     mesurer l'etat chaud avec tous les modeles charges.
#
# NLLB et Whisper restent lazy au demarrage dans tous les profils, conformement
# a l'ADR-0011. ENABLE_WHISPER=true autorise son chargement au premier vocal FR ;
# ce flag ne le precharge pas.
#
# ENABLE_* : si false, le modele n'est ni pre-charge ni chargeable (503)
# PRELOAD_* : si false, le modele reste chargeable mais lazy (1er appel)
ENABLE_WHISPER=true
ENABLE_MMS_DYU=true
ENABLE_MMS_BAM=true
PRELOAD_TTS_DIOULA=true
PRELOAD_TTS_BAMBARA=true

# ──────────────────────────────────────────────────
# PIPER TTS (FR + EN) — portabilité OS
# ──────────────────────────────────────────────────
# Tous les chemins sont configurables. Aucun chemin hardcoded dans le code.
# Si PIPER_MODEL_FR ou PIPER_MODEL_EN est vide, le TTS de la langue concernée
# est silencieusement désactivé (le bot envoie le texte sans audio).
#
# Linux / macOS (binaire installé via package ou wget depuis github) :
#   PIPER_PATH=piper
#   PIPER_MODEL_FR=/opt/piper-voices/fr_FR-tom-medium.onnx
#   PIPER_MODEL_EN=/opt/piper-voices/en_US-amy-medium.onnx
#
# Windows :
#   PIPER_PATH=C:\piper-tts\piper.exe
#   PIPER_MODEL_FR=C:\piper-tts\fr_FR-tom-medium.onnx
#   PIPER_MODEL_EN=C:\piper-tts\en_US-amy-medium.onnx
#
# Défaut (vide) : PIPER_PATH cherche "piper" dans PATH système ; modèles
# vides → TTS désactivé pour cette langue.
PIPER_PATH=
PIPER_MODEL_FR=
PIPER_MODEL_EN=

# ──────────────────────────────────────────────────
# POSTGRESQL + PGVECTOR (Sprint F Phase A — dev local)
# ──────────────────────────────────────────────────
# Ces variables ne sont PAS utilisées par le code prod actuel.
# Elles sont ajoutées en Phase A (ADR-0008) pour préparer la migration
# ChromaDB → PostgreSQL+pgvector. Le code applicatif lira ces variables
# à partir de Phase B/C (ADR-0008).
#
# Le password ci-dessous est destiné UNIQUEMENT au dev local
# (cohérent avec docker-compose.dev.yml). Ne JAMAIS réutiliser en
# staging/production : un gestionnaire de secrets est exigé.

# Variables individuelles (lues par docker-compose.dev.yml)
POSTGRES_USER=wourri
POSTGRES_PASSWORD=wourri_dev_2026
POSTGRES_DB=wourri_dev

# Chaîne complète (pour SQLAlchemy/psycopg en Phase B+, port 5433 host)
# Driver `+psycopg` : exige psycopg v3 (pas psycopg2). Cohérent avec
# `requirements.txt` Phase B. Si vous ouvrez un psql en CLI, la chaîne
# `postgresql://...` (sans `+psycopg`) reste valide.
POSTGRES_URL=postgresql+psycopg://wourri:wourri_dev_2026@localhost:5433/wourri_dev

# Dashboard /admin/dashboard (ADR-0017).
# Stocke uniquement des métriques techniques sans message, transcription,
# user_id, numéro de téléphone ou adresse IP. Nécessite POSTGRES_URL.
ADMIN_METRICS_ENABLED=true

# Dimension des vecteurs d'embedding (MiniLM-L12-v2 = 384 dims)
# Ne PAS changer sans ADR dédié — impact direct sur le schéma Phase B.
POSTGRES_VECTOR_DIM=384
