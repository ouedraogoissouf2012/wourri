# WOURI - Configuration
# Copier ce fichier vers .env et remplir les valeurs

# ──────────────────────────────────────────────────
# ENVIRONNEMENT
# ──────────────────────────────────────────────────
# "development" (défaut) ou "production"
# En production : API_SECRET_KEY obligatoire, debug forcé à False
ENV=development

# ──────────────────────────────────────────────────
# SÉCURITÉ — OBLIGATOIRE EN PRODUCTION
# ──────────────────────────────────────────────────
# Clé secrète pour authentifier les appels API (header X-API-Key)
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
# OBLIGATOIRE si ENV=production (le serveur refuse de démarrer sans elle)
API_SECRET_KEY=

# ──────────────────────────────────────────────────
# APIs EXTERNES
# ──────────────────────────────────────────────────
# DeepSeek API (obligatoire pour le chat et les fallbacks)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq API (optionnel — Whisper ASR cloud)
GROQ_API_KEY=

# ──────────────────────────────────────────────────
# OPTIONS
# ──────────────────────────────────────────────────
DEBUG=true
TTS_FRENCH_VOICE=fr-FR-VivienneMultilingualNeural
AUDIO_OUTPUT_DIR=static/audio
