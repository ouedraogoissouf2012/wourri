# WOURI - Configuration
# Copier ce fichier vers .env et remplir les valeurs

# ──────────────────────────────────────────────────
# ENVIRONNEMENT
# ──────────────────────────────────────────────────
# "development" (défaut) ou "production"
# En production : API_SECRET_KEY obligatoire, debug forcé à False
ENV=development

# ──────────────────────────────────────────────────
# SÉCURITÉ — OBLIGATOIRE EN PRODUCTION
# ──────────────────────────────────────────────────
# Clé secrète pour authentifier les appels API (header X-API-Key)
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
# OBLIGATOIRE si ENV=production (le serveur refuse de démarrer sans elle)
API_SECRET_KEY=

# ──────────────────────────────────────────────────
# APIs EXTERNES
# ──────────────────────────────────────────────────
# DeepSeek API (obligatoire pour le chat et les fallbacks)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq API (optionnel — Whisper ASR cloud)
GROQ_API_KEY=

# ──────────────────────────────────────────────────
# OPTIONS
# ──────────────────────────────────────────────────
DEBUG=true
TTS_FRENCH_VOICE=fr-FR-VivienneMultilingualNeural
AUDIO_OUTPUT_DIR=static/audio

# ──────────────────────────────────────────────────
# CHEMINS OPTIONNELS (si outils non dans le PATH)
# ──────────────────────────────────────────────────
# FFmpeg — laisser vide si ffmpeg est dans le PATH système
# Windows : C:/ffmpeg/bin/ffmpeg.exe
# Linux   : /usr/bin/ffmpeg
FFMPEG_PATH=

# Modèle NeMo ASR (Soloni bambara)
# Par défaut : ~/.cache/huggingface/hub/models--RobotsMali--soloni-114m-tdt-ctc-v0/...
NEMO_MODEL_PATH=

# Piper TTS français (optionnel)
PIPER_PATH=
PIPER_MODEL=

# ──────────────────────────────────────────────────
# POSTGRESQL + PGVECTOR (Sprint F Phase A — dev local)
# ──────────────────────────────────────────────────
# Ces variables ne sont PAS utilisées par le code prod actuel.
# Elles sont ajoutées en Phase A (ADR-0008) pour préparer la migration
# ChromaDB → PostgreSQL+pgvector. Le code applicatif lira ces variables
# à partir de Phase B/C (ADR-0008).
#
# Le password ci-dessous est destiné UNIQUEMENT au dev local
# (cohérent avec docker-compose.dev.yml). Ne JAMAIS réutiliser en
# staging/production : un gestionnaire de secrets est exigé.

# Variables individuelles (lues par docker-compose.dev.yml)
POSTGRES_USER=wourri
POSTGRES_PASSWORD=wourri_dev_2026
POSTGRES_DB=wourri_dev

# Chaîne complète (pour SQLAlchemy/psycopg en Phase B+, port 5433 host)
# Driver `+psycopg` : exige psycopg v3 (pas psycopg2). Cohérent avec
# `requirements.txt` Phase B. Si vous ouvrez un psql en CLI, la chaîne
# `postgresql://...` (sans `+psycopg`) reste valide.
POSTGRES_URL=postgresql+psycopg://wourri:wourri_dev_2026@localhost:5433/wourri_dev

# Dimension des vecteurs d'embedding (MiniLM-L12-v2 = 384 dims)
# Ne PAS changer sans ADR dédié — impact direct sur le schéma Phase B.
POSTGRES_VECTOR_DIM=384
