# Configuration locale (mettre production uniquement dans le conteneur prod)
# En production, WOURI_API_KEY vide provoque un arret immediat volontaire.
NODE_ENV=development
PORT=3001

# Configuration applicative
LOG_LEVEL=info

# URL de l'API Python Wourri
WOURI_API_URL=http://localhost:8000

# [P0-02a] Cle d'authentification pour les appels backend Wourri
# Doit correspondre a API_SECRET_KEY dans wouri-api/.env
# Laisser vide en dev local si API_SECRET_KEY n'est pas configuree cote backend
# OBLIGATOIRE en production
WOURI_API_KEY=

# [ADR-0012 Sprint A] CORS strict — allow-list des origines autorisees
# Liste separee par virgules, sans espaces inutiles
# Exemple : ALLOWED_ORIGINS=https://dashboard.example.com,https://admin.wourri.ci
# Si vide (defaut) -> CORS refuse toute origine cross-domain (mode strict)
# Les routes restent accessibles same-origin (curl, navigation directe, monitoring)
ALLOWED_ORIGINS=

# Profil des delais "simulation humaine" avant chaque envoi (lib/human_delays.js)
#   fast    (defaut) : delais courts (~0,3-0,65 s cumules) — reactivite prioritaire
#   natural          : valeurs historiques anti-ban (~1,8-3,8 s cumules) — rollback
#                      si suspicion de detection/ban Baileys
#   off              : aucun delai artificiel
HUMAN_DELAY_PROFILE=fast
