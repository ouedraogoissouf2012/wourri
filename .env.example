# Configuration locale (mettre production uniquement dans le conteneur prod)
# En production, WOURI_API_KEY vide provoque un arret immediat volontaire.
NODE_ENV=development
PORT=3001

# Configuration applicative
LOG_LEVEL=info

# URL de l'API Python Wourri
WOURI_API_URL=http://localhost:8000

# [P0-02a] Cle d'authentification pour les appels backend Wourri
# Doit correspondre a API_SECRET_KEY dans wouri-api/.env
# Laisser vide en dev local si API_SECRET_KEY n'est pas configuree cote backend
# OBLIGATOIRE en production
WOURI_API_KEY=

# [#257] Pattern Docker secrets : si defini, le contenu du fichier a ce chemin
# est utilise comme cle (prioritaire sur WOURI_API_KEY ; newline finale trimee).
# En prod compose : WOURI_API_KEY_FILE=/run/secrets/wouri_api_key
# Le fichier doit contenir la MEME valeur que le secret api_secret_key de l'API.
# Laisser vide en dev local.
WOURI_API_KEY_FILE=

# [L1 #408] Cle d'authentification ENTRANTE (admin) du serveur WhatsApp.
# Protege /logout, /qr, /qr-page, /users, /status, / (sauf /health et /ready).
# Header attendu : X-WA-Admin-Key (comparaison a temps constant).
# OBLIGATOIRE en production (vide + NODE_ENV=production -> arret immediat au boot).
# Distincte de WOURI_API_KEY (qui signe les appels SORTANTS vers l'API).
WA_ADMIN_KEY=

# [L1 #408] Pattern Docker secrets pour WA_ADMIN_KEY (prioritaire si defini).
# En prod compose : WA_ADMIN_KEY_FILE=/run/secrets/wa_admin_key
WA_ADMIN_KEY_FILE=

# [ADR-0012 Sprint A] CORS strict — allow-list des origines autorisees
# Liste separee par virgules, sans espaces inutiles
# Exemple : ALLOWED_ORIGINS=https://dashboard.example.com,https://admin.wourri.ci
# Si vide (defaut) -> CORS refuse toute origine cross-domain (mode strict)
# Les routes restent accessibles same-origin (curl, navigation directe, monitoring)
ALLOWED_ORIGINS=

# Profil des delais "simulation humaine" avant chaque envoi (lib/human_delays.js)
#   fast    (defaut) : delais courts (~0,3-0,65 s cumules) — reactivite prioritaire
#   natural          : valeurs historiques anti-ban (~1,8-3,8 s cumules) — rollback
#                      si suspicion de detection/ban Baileys
#   off              : aucun delai artificiel
HUMAN_DELAY_PROFILE=fast

# [L2 #409] Convex — diffusion alertes en pull (le serveur va chercher)
# Laisser vide en local si Convex n'est pas branché (le tick est alors no-op).
CONVEX_URL=
CONVEX_DISPATCH_KEY=
CONVEX_DISPATCH_KEY_FILE=
CONVEX_CALLBACK_KEY=
CONVEX_CALLBACK_KEY_FILE=
# Secret HMAC contactRef (jamais dans Convex). Pattern *_FILE en prod.
WOURI_CONTACTREF_HMAC_SECRET=
WOURI_CONTACTREF_HMAC_SECRET_FILE=
# Intervalle de poll (ms). Défaut 90000 (1,5 min, fourchette brief 1–2 min).
ALERTS_POLL_MS=90000
# [L5c #412] Org Convex pour POST /whatsapp/optout (pas de numéro).
WOURI_ORGANIZATION_ID=
