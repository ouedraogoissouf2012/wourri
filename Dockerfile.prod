# syntax=docker/dockerfile:1.7
#
# Wourri — Dockerfile production wouri-api (Sprint I.a, issue #201).
#
# Stratégie tranchée par le code-architect (cf. plan Sprint I) :
#   D1 — base python:3.11-slim-bookworm (PyTorch CPU compatible, taille minimale)
#   D3 — multi-stage build (builder = wheels, runtime = venv copié)
#   D4 — modèles ML essentiels préchargés au BUILD dans le cache HuggingFace
#        puis initialisés depuis le volume persistant au runtime
#
# Pas de secret dans l'image (toute injection via `--env-file .env.prod`
# au runtime, cf. décision D9).

# ╭──────────────────────────────────────────────────────────────────────╮
# │ STAGE 1 : builder                                                    │
# │ Installe les dépendances Python dans un venv isolé.                  │
# │ Contient les outils de compilation (gcc, build-essential) qui ne     │
# │ doivent PAS finir dans l'image runtime.                              │
# ╰──────────────────────────────────────────────────────────────────────╯
FROM python:3.11-slim-bookworm AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Dépendances système nécessaires pour compiler les wheels Python
# (psycopg, soundfile, etc.). Supprimées au stage runtime.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        libsndfile1-dev \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Création du venv isolé qui sera copié au stage runtime
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Installation des dépendances Python en couche cacheable
# (requirements.txt change moins souvent que le code)
COPY requirements.txt /tmp/requirements.txt
# torch CPU-only depuis l'index PyTorch AVANT le reste : evite la pile CUDA
# nvidia (~11 Go inutiles sur un serveur CPU). `torch>=2.1.0` du requirements
# est alors deja satisfait par 2.13.0+cpu → pip ne le re-telecharge pas.
# Mesure conteneur : torch CUDA+nvidia ~11 Go vs torch CPU 754 Mo
# (image attendue ~19 Go → ~5 Go).
RUN pip install --upgrade pip setuptools wheel \
    && pip install torch==2.13.0 --index-url https://download.pytorch.org/whl/cpu \
    && pip install -r /tmp/requirements.txt


# ╭──────────────────────────────────────────────────────────────────────╮
# │ STAGE 2 : runtime                                                    │
# │ Image finale minimale, uniquement les libs runtime + le code +       │
# │ le venv pré-construit.                                               │
# ╰──────────────────────────────────────────────────────────────────────╯
FROM python:3.11-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    # D4 : cache HuggingFace persistant sur volume nommé en prod
    HF_HOME=/app/.cache/huggingface \
    TRANSFORMERS_CACHE=/app/.cache/huggingface \
    HF_DATASETS_CACHE=/app/.cache/huggingface \
    # Voix Piper FR pour le TTS francais (app/services/tts_french.py lit PIPER_MODEL_FR)
    PIPER_MODEL_FR=/app/piper-voices/fr_FR-tom-medium.onnx

# Dépendances système runtime UNIQUEMENT (pas de compilateurs).
# libpq5 pour psycopg, libsndfile1 pour soundfile, ffmpeg pour pydub.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 \
        libsndfile1 \
        ffmpeg \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Utilisateur non-root pour réduire la surface d'attaque
# (cf. agent_security_rules.md — pas de container en root inutilement)
RUN useradd --create-home --shell /bin/bash --uid 1000 wourri

WORKDIR /app

# Copie du venv depuis le stage builder avec le bon proprietaire directement.
# IMPORTANT : un `RUN chown -R /opt/venv` apres le COPY duplique le contenu du
# venv dans une nouvelle couche overlay (5,98 GB mesures lors de l'issue #39).
# `COPY --chown` applique les metadonnees pendant la copie, sans couche doublon.
COPY --from=builder --chown=wourri:wourri /opt/venv /opt/venv

# Copie du code source (sélective — .dockerignore exclut le reste).
# Ordre par fréquence de changement : moins fréquent d'abord = meilleur cache.
# Sprint I.a review MAJOR-2 : alembic.ini est SAFE (sqlalchemy.url=vide,
# l'URL réelle est résolue par alembic/env.py via app/db/url_resolver.py :
# env POSTGRES_URL, ou composants POSTGRES_* + secret postgres_password
# depuis #258). Aucun credential dans l'image.
COPY --chown=wourri:wourri alembic.ini ./
COPY --chown=wourri:wourri alembic/ ./alembic/
COPY --chown=wourri:wourri db-init/ ./db-init/
COPY --chown=wourri:wourri dictionnaires/ ./dictionnaires/
COPY --chown=wourri:wourri scripts/ ./scripts/
COPY --chown=wourri:wourri templates/ ./templates/
COPY --chown=wourri:wourri app/ ./app/

# Prépare les dossiers runtime (cache HF, audio output, logs).
# Sprint I.a review MAJOR-1 : ces 3 dossiers DOIVENT être couverts par des
# volumes nommés en prod (cf. docker-compose.prod.yml Sprint I.c).
RUN mkdir -p /app/.cache/huggingface /app/static/audio /app/logs \
    && chown -R wourri:wourri /app

USER wourri

# Voix Piper FR (fr_FR-tom-medium, ~63 Mo) pour le TTS francais.
# Le CLI `piper` vient du paquet piper-tts (requirements.txt) ; ici on ne
# telecharge que le modele, au chemin pointe par PIPER_MODEL_FR. Sans lui,
# synthesize_french() se degrade proprement (texte FR sans audio).
RUN mkdir -p /app/piper-voices && \
    curl -fsSL -o /app/piper-voices/fr_FR-tom-medium.onnx \
      https://huggingface.co/rhasspy/piper-voices/resolve/main/fr/fr_FR/tom/medium/fr_FR-tom-medium.onnx && \
    curl -fsSL -o /app/piper-voices/fr_FR-tom-medium.onnx.json \
      https://huggingface.co/rhasspy/piper-voices/resolve/main/fr/fr_FR/tom/medium/fr_FR-tom-medium.onnx.json && \
    echo "[BUILD] voix Piper FR telechargee"

# Issue #217 : préload des modèles HuggingFace essentiels pendant le build.
# Cold-start passe de ~15 min à ~30 s (lecture depuis l'image vs download HF).
# Trade-off : les poids fp32 occupent plusieurs GB dans l'image. La taille
# doit etre mesuree apres chaque changement de modele avec `docker image
# inspect` et `docker history` (ne pas confondre "600M parametres" et 600 MB).
#   - Build CI : ~+5 min (download HF + tar layer cached)
# Modèles NON-préchargés (lazy on-demand) :
#   - Whisper large-v3-turbo (~1.5 GB) : utilisé seulement par mode `french`
#   - TTS ivoirien (ati, dyi, etc.) : usage minoritaire
#   - NeMo Soloni (.nemo, ~150 MB) : workflow HF Hub différent, lazy à init
#
# IMPORTANT : `VOLUME ["/app/.cache/huggingface"]` est déclaré APRÈS ces RUN.
# Au runtime : si le volume nommé `wourri_hf_cache` est vide → Docker copie le
# contenu de l'image (modèles préchargés). Si le volume existe → l'image est
# ignorée pour ce path. Pour profiter d'un modèle mis à jour : purger le volume
# (`docker volume rm wourri_hf_cache`) au prochain restart. Documenté dans
# docs/deployment.md §rotation/upgrade.

# 1. TTS Bambara MMS (~120 MB) — utilisé par tous les vocaux sortants bambara
RUN python -c "from transformers import VitsModel, AutoTokenizer; \
VitsModel.from_pretrained('facebook/mms-tts-bam'); \
AutoTokenizer.from_pretrained('facebook/mms-tts-bam'); \
print('[BUILD] mms-tts-bam preloaded')"

# 2. TTS Dioula MMS (~120 MB) — utilisé par tous les vocaux sortants dioula
RUN python -c "from transformers import VitsModel, AutoTokenizer; \
VitsModel.from_pretrained('facebook/mms-tts-dyu'); \
AutoTokenizer.from_pretrained('facebook/mms-tts-dyu'); \
print('[BUILD] mms-tts-dyu preloaded')"

# 3. NLLB-200-distilled-600M (600M parametres, ~2,5 GB en fp32) —
#    traduction FR → bambara/dioula. `huggingface_hub` peut conserver en plus
#    un cache Xet temporaire de taille comparable : le supprimer DANS le meme
#    RUN evite qu'il soit fige dans la couche finale (4,94 GB mesures avant fix).
RUN python -c "from transformers import AutoModelForSeq2SeqLM, AutoTokenizer; \
AutoModelForSeq2SeqLM.from_pretrained('facebook/nllb-200-distilled-600M'); \
AutoTokenizer.from_pretrained('facebook/nllb-200-distilled-600M'); \
print('[BUILD] nllb-200-distilled-600M preloaded')" \
    && rm -rf "${HF_HOME}/xet"

# 4. Embedding multilingue — utilisé par scripts/import_corpus_ivr.py + tests
#    (issue #229) et lié à vdb_service.py (Phase E ADR-0008).
RUN python -c "from sentence_transformers import SentenceTransformer; \
SentenceTransformer('sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2'); \
print('[BUILD] paraphrase-multilingual-MiniLM-L12-v2 preloaded')"

# 5. Modele d'embedding du corpus IVR sauvegarde au chemin LOCAL exige par
#    app/services/corpus_service.py (_MODEL_PATH = <repo>/modeles_manuels/...).
#    Ce service exige ce dossier SANS fallback HuggingFace (contrairement a
#    scripts/import_corpus_ivr.py qui, lui, retombe sur le modele HF). Sans
#    cette etape, modeles_manuels/ n'est PAS embarque dans l'image → toute
#    recherche corpus leve RuntimeError → fallback DeepSeek+NLLB (dioula
#    hors-corpus au lieu du dioula valide). On sauvegarde le MEME modele que
#    l'import (paraphrase-multilingual-MiniLM-L12-v2) → embeddings coherents.
RUN python -c "from sentence_transformers import SentenceTransformer; \
SentenceTransformer('sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2') \
.save('/app/modeles_manuels/paraphrase-multilingual-MiniLM-L12-v2'); \
print('[BUILD] modele embedding corpus sauvegarde dans modeles_manuels')"

# Déclaration explicite des volumes attendus en runtime.
# Si l'opérateur lance `docker run` sans monter ces volumes, Docker affichera
# un avertissement (volumes anonymes créés) → on évite la régression
# silencieuse où les modèles ML disparaissent à chaque `--rm`.
VOLUME ["/app/.cache/huggingface", "/app/static/audio", "/app/logs"]

# Healthcheck applicatif — Issue #217 : start-period 120s (vs 900s avant)
# car cold-start ne nécessite plus le download HF (modèles préchargés dans
# l'image). Lazy-loading des modèles restants (Whisper, NeMo) absorbé.
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
    CMD curl --silent --fail http://localhost:8000/health || exit 1

EXPOSE 8000

# uvicorn en mode prod : 2 workers, sans reload, log JSON propre.
# Les workers permettent de gérer N requêtes concurrentes (~30 utilisateurs
# WhatsApp simultanés visés pour le staging).
#
# --proxy-headers (ADR-0018 / #307) : uvicorn 0.27 ne fait confiance à
# X-Forwarded-For QUE depuis FORWARDED_ALLOW_IPS (env var, défaut 127.0.0.1
# = personne en pratique : le trafic Docker arrive en 172.x). Au Sprint J
# (reverse proxy #202), renseigner FORWARDED_ALLOW_IPS avec l'IP du proxy —
# JAMAIS '*' : un X-Forwarded-For forgé permettrait de tourner la clé du
# rate limiting sur des IP fictives (bypass).
CMD ["uvicorn", "app.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "2", \
     "--log-level", "info", \
     "--access-log", \
     "--proxy-headers"]
