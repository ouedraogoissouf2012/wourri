# Wourri — Template configuration production (Sprint I.c, issue #201).
# ─────────────────────────────────────────────────────────────────────
#
# Procédure :
#   1. Sur la VM Scaleway, copier ce template :
#        cp .env.prod.template .env.prod
#   2. Remplir TOUTES les valeurs ci-dessous (aucune ne doit rester vide).
#   3. Permissions strictes (lecture user uniquement) :
#        chmod 600 .env.prod
#   4. Vérifier que `.env.prod` est dans `.gitignore` (jamais commité).
#
# IMPORTANT :
#   - Aucune valeur de ce fichier ne doit JAMAIS être commitée
#     (`.env.prod` est exclu par .gitignore et .dockerignore).
#   - Génération des secrets recommandée :
#       openssl rand -base64 32     # → POSTGRES_PASSWORD, WOURI_API_KEY
#   - Rotation des secrets : cf. docs/deployment.md §rotation.

# ╭──────────────────────────────────────────────────────────────────────╮
# │ PostgreSQL                                                           │
# ╰──────────────────────────────────────────────────────────────────────╯
# Utilisateur applicatif (créé au premier démarrage par l'image postgres).
POSTGRES_USER=wourri

# Mot de passe : 32+ caractères, généré aléatoirement.
# Exemple : `openssl rand -base64 32`
POSTGRES_PASSWORD=REPLACE_ME_avec_openssl_rand_base64_32

# Nom de la base applicative (défaut : `wourri_prod`).
POSTGRES_DB=wourri_prod

# ╭──────────────────────────────────────────────────────────────────────╮
# │ wouri-api ↔ whatsapp-server (clé partagée X-API-Key)                 │
# ╰──────────────────────────────────────────────────────────────────────╯
# 32+ caractères. Identique côté API et côté WhatsApp.
# Exemple : `openssl rand -base64 32`
WOURI_API_KEY=REPLACE_ME_avec_openssl_rand_base64_32

# ╭──────────────────────────────────────────────────────────────────────╮
# │ CORS                                                                 │
# ╰──────────────────────────────────────────────────────────────────────╯
# Liste séparée par virgules des origines autorisées en cross-domain.
# Sprint I : laisser vide (pas de frontend web → mode strict, refuse tout
# cross-domain mais accepte same-origin / monitoring sans header Origin).
# Ex futur : ALLOWED_ORIGINS=https://dashboard.wourri.ci,https://admin.wourri.ci
ALLOWED_ORIGINS=

# ╭──────────────────────────────────────────────────────────────────────╮
# │ Niveau de log                                                        │
# ╰──────────────────────────────────────────────────────────────────────╯
# trace | debug | info | warn | error | fatal (défaut : info)
LOG_LEVEL=info

# ╭──────────────────────────────────────────────────────────────────────╮
# │ Mode corpus (cf. ADR-0008 — migration ChromaDB → pgvector)           │
# ╰──────────────────────────────────────────────────────────────────────╯
# Valeurs possibles : chroma | dual | pgvector
# Sprint I : démarrer en `dual` permet de valider Postgres sur le terrain
# AVANT de basculer en `pgvector` pur (Phase E ADR-0008 / Sprint K).
CORPUS_STORAGE_MODE=dual

# ╭──────────────────────────────────────────────────────────────────────╮
# │ Tags d'images Docker (déployées depuis ghcr.io)                      │
# ╰──────────────────────────────────────────────────────────────────────╯
# Par défaut `latest` (= dernier merge sur APIPy / whatsappServeur).
# Pour pinner une version : remplacer par un sha commit (`sha-abc123...`).
# Le pin permet rollback explicite : `API_IMAGE_TAG=sha-<previous-commit>`.
API_IMAGE_TAG=latest
WA_IMAGE_TAG=latest

# ╭──────────────────────────────────────────────────────────────────────╮
# │ Monitoring externe — healthchecks.io (issue #220)                    │
# ╰──────────────────────────────────────────────────────────────────────╯
# 3 URLs de ping vers https://healthchecks.io (compte gratuit, 20 checks).
# Procédure de création dans docs/deployment.md §Monitoring externe.
#
# Format : https://hc-ping.com/<uuid>
# Laisser VIDE pour désactiver le ping (le système continue de fonctionner
# sans alerte externe — utile en dev local ou si pas encore configuré).

# Ping émis à la fin de backup.sh (cron 02h15 UTC). Alerte healthchecks.io
# si pas de ping reçu en 26h (= backup raté ou cron arrêté).
HEALTHCHECKS_BACKUP_URL=

# Ping périodique cron toutes les 5 min depuis la VM (cf. runbook).
# Alerte si pas de ping en 10 min = wouri-api down ou /health KO.
HEALTHCHECKS_API_URL=

# Idem pour whatsapp-server /health.
HEALTHCHECKS_WA_URL=
