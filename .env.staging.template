# Wourri — Template configuration STAGING (Sprint J, issue #202).
# ───────────────────────────────────────────────────────────────────
#
# Procedure :
#   1. Sur la VM staging, copier ce template :
#        cp .env.staging.template .env.staging
#   2. Remplir TOUTES les valeurs ci-dessous (aucune ne doit rester vide).
#   3. Permissions strictes :
#        chmod 600 .env.staging
#   4. Verifier que `.env.staging` est dans `.gitignore` (deja le cas).
#
# IMPORTANT :
#   - Les secrets staging DOIVENT etre DIFFERENTS des secrets prod.
#     Sinon une compromission staging compromet prod.
#   - Generation des secrets : `openssl rand -base64 32`
#   - La VM staging est isolee de la prod (cf. docs/staging-deployment.md).

# ╭──────────────────────────────────────────────────────────────────────╮
# │ PostgreSQL                                                           │
# ╰──────────────────────────────────────────────────────────────────────╯
POSTGRES_USER=wourri
POSTGRES_PASSWORD=REPLACE_ME_avec_openssl_rand_base64_32_DIFFERENT_DE_PROD
POSTGRES_DB=wourri_staging

# ╭──────────────────────────────────────────────────────────────────────╮
# │ wouri-api ↔ whatsapp-server                                          │
# ╰──────────────────────────────────────────────────────────────────────╯
# Cle distincte de la prod. Si compromission staging != compromission prod.
WOURI_API_KEY=REPLACE_ME_avec_openssl_rand_base64_32_DIFFERENT_DE_PROD

# Cle precedente pour rotation zero-downtime (laisser vide en temps normal).
WOURI_API_KEY_PREVIOUS=

# ╭──────────────────────────────────────────────────────────────────────╮
# │ CORS                                                                 │
# ╰──────────────────────────────────────────────────────────────────────╯
# Staging : laisser vide pour mode strict (pas de frontend web non plus).
# Si test d'un dashboard staging : ALLOWED_ORIGINS=https://dashboard-staging.wourri.ci
ALLOWED_ORIGINS=

# ╭──────────────────────────────────────────────────────────────────────╮
# │ Niveau de log                                                        │
# ╰──────────────────────────────────────────────────────────────────────╯
# Staging : `debug` par defaut (plus de signal pour debugger les bugs
# remontes avant qu'ils n'atteignent la prod). Acceptable car volume
# utilisateurs faible.
LOG_LEVEL=debug

# ╭──────────────────────────────────────────────────────────────────────╮
# │ Tags d'images Docker (depuis ghcr.io)                                │
# ╰──────────────────────────────────────────────────────────────────────╯
# Par defaut `staging` (= dernier merge sur APIPy/whatsappServeur).
# Le workflow CI deploy-api-staging.yml taggue les images avec :staging.
# Pour pinner un sha : API_IMAGE_TAG=sha-abc123...
API_IMAGE_TAG=staging
WA_IMAGE_TAG=staging

# ╭──────────────────────────────────────────────────────────────────────╮
# │ Monitoring externe — healthchecks.io (issue #220, deja livre PR #225)│
# ╰──────────────────────────────────────────────────────────────────────╯
# Compte healthchecks.io distinct du compte prod recommande (sinon meme
# alerte aggregee pour 2 environnements = confusion durant un incident).
HEALTHCHECKS_BACKUP_URL=
HEALTHCHECKS_API_URL=
HEALTHCHECKS_WA_URL=
