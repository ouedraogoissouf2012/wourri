// Wourri — collecte des logs Docker STAGING vers Loki (ADR-0016).
//
// Le socket Docker est monté en lecture seule par docker-compose.staging.yml.
// Seuls les conteneurs dont le nom correspond à wourri_*_staging sont gardés.

logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "wourri_staging" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "15s"

  filter {
    name   = "name"
    values = ["wourri_.*_staging"]
  }
}

discovery.relabel "wourri_staging" {
  targets = discovery.docker.wourri_staging.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container_name"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/wourri_([a-z_]+)_staging"
    target_label  = "job"
    replacement   = "$1"
  }

  rule {
    target_label = "stack"
    replacement  = "wourri-staging"
  }
}

loki.source.docker "wourri_staging" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.wourri_staging.output
  labels     = { stack = "wourri-staging" }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
